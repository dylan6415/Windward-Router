<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Windward Route & Navigation Optimizer</title>
  <style>
    :root {
      --bg-main: #0f172a;
      --panel-bg: #1e293b;
      --accent: #38bdf8;
      --accent-hover: #0284c7;
      --text: #f8fafc;
      --text-muted: #94a3b8;
      --border: #334155;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background-color: var(--bg-main);
      color: var(--text);
      display: flex;
      flex-direction: column;
      min-height: 100vh;
      padding: 1.5rem;
      gap: 1.5rem;
    }

    header {
      border-bottom: 1px solid var(--border);
      padding-bottom: 1rem;
    }

    header h1 { font-size: 1.5rem; color: var(--accent); }
    header p { color: var(--text-muted); font-size: 0.9rem; margin-top: 0.25rem; }

    .grid-container {
      display: grid;
      grid-template-columns: 340px 1fr;
      gap: 1.5rem;
      flex: 1;
    }

    @media (max-width: 900px) {
      .grid-container { grid-template-columns: 1fr; }
    }

    .panel {
      background: var(--panel-bg);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 1.25rem;
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    .panel-title {
      font-size: 1.1rem;
      font-weight: 600;
      border-bottom: 1px solid var(--border);
      padding-bottom: 0.5rem;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }

    label { font-size: 0.85rem; color: var(--text-muted); }

    input, select {
      background: var(--bg-main);
      border: 1px solid var(--border);
      color: var(--text);
      padding: 0.6rem;
      border-radius: 4px;
      font-size: 0.9rem;
    }

    input:focus, select:focus {
      outline: 1px solid var(--accent);
    }

    button {
      background: var(--accent);
      color: #000;
      border: none;
      padding: 0.75rem;
      font-weight: 600;
      border-radius: 4px;
      cursor: pointer;
      transition: background 0.2s;
    }

    button:hover { background: var(--accent-hover); color: #fff; }

    .wind-display {
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: var(--bg-main);
      padding: 0.75rem;
      border-radius: 6px;
      border: 1px solid var(--border);
    }

    .compass {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      border: 2px solid var(--accent);
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .needle {
      width: 4px;
      height: 24px;
      background: #ef4444;
      position: absolute;
      transform-origin: bottom center;
      top: 4px;
      border-radius: 2px;
      transition: transform 0.3s ease;
    }

    .table-wrapper {
      overflow-y: auto;
      max-height: 600px;
    }

    .results-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.85rem;
      text-align: left;
    }

    .results-table th, .results-table td {
      padding: 0.65rem;
      border-bottom: 1px solid var(--border);
    }

    .results-table th {
      color: var(--text-muted);
      font-weight: 500;
      position: sticky;
      top: 0;
      background: var(--panel-bg);
    }

    .badge {
      display: inline-block;
      padding: 0.2rem 0.5rem;
      border-radius: 4px;
      font-size: 0.75rem;
      font-weight: bold;
    }
    
    .badge-valid { background: #0284c7; color: #fff; }
    .badge-impossible { background: #ef4444; color: #fff; }
    
    tr.impossible-row {
      opacity: 0.5;
    }
  </style>
</head>
<body>

  <header>
    <h1>Windward Route & Navigation Optimizer</h1>
    <p>Filters out impossible upwind routes based on wind direction.</p>
  </header>

  <div class="grid-container">
    <aside class="panel">
      <div class="panel-title">Sailing & Wind Parameters</div>

      <div class="form-group">
        <label>Wind Bearing (° Angle)</label>
        <input type="number" id="windInput" value="0" min="0" max="359" oninput="updateCompass()">
      </div>

      <div class="wind-display">
        <div>
          <div style="font-size: 0.8rem; color: var(--text-muted);">Wind Heading</div>
          <strong id="windDegReadout">0° North</strong>
        </div>
        <div class="compass">
          <div class="needle" id="compassNeedle"></div>
        </div>
      </div>

      <div class="form-group">
        <label>Ship Speed (Knots)</label>
        <input type="number" id="shipSpeed" value="21.5" step="0.1" min="1">
      </div>

      <div class="form-group">
        <label>Ship Select</label>
        <select id="shipSelect">
          <option value="Prince">Prince (230 Tonnage)</option>
          <option value="Ontario">Ontario (200 Tonnage)</option>
        </select>
      </div>

      <div class="form-group">
        <label>Origin Port</label>
        <select id="originIsland"></select>
      </div>

      <button onclick="calculateRoutes()">Calculate Routes</button>
    </aside>

    <main class="panel">
      <div class="panel-title">Destination Navigation Table</div>
      
      <div class="table-wrapper">
        <table class="results-table">
          <thead>
            <tr>
              <th>Destination</th>
              <th>Departure Bearing</th>
              <th>Status</th>
              <th>Est. Time</th>
              <th>Est. Profit</th>
            </tr>
          </thead>
          <tbody id="resultsBody">
            <tr>
              <td colspan="5" style="text-align:center; color: var(--text-muted);">Select an origin port and click calculate.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </main>
  </div>

