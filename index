        {"categoryId": "3", "position": [489.31, 824.13], "popup": {"title": "Sandy Settlement"}},
        {"categoryId": "3", "position": [514.59, 829.61], "popup": {"title": "Saint Nicolas"}},
        {"categoryId": "4", "position": [587.34, 818.29], "popup": {"title": "Fort Saint Paul"}},
        {"categoryId": "3", "position": [581.24, 799.20], "popup": {"title": "Taylor's Town"}},
        {"categoryId": "7", "position": [794.94, 380.39], "popup": {"title": "Deadman's Murica"}},
        {"categoryId": "7", "position": [835.37, 399.75], "popup": {"title": "Snake Prosper"}},
        {"categoryId": "7", "position": [799.75, 419.75], "popup": {"title": "Caledonia"}},
        {"categoryId": "7", "position": [780.87, 420.43], "popup": {"title": "Snakes Prosper"}},
        {"categoryId": "8", "position": [796.50, 432.50], "popup": {"title": "Fort Dalton"}},
        {"categoryId": "8", "position": [887.75, 404.25], "popup": {"title": "Fort Makser"}}
      ]
    };

    const SHIP_CONFIGS = {
      "Prince": { tonnage: 230 },
      "Ontario": { tonnage: 200 }
    };

    let PORTS = [];
    
    // Benchmark distance for Sainte Rose [455, 97.75] -> New Catalina [811.22, 639.31]
    const BENCHMARK_DIST = Math.hypot(811.22 - 455, 639.31 - 97.75); // ~648.512
    // Profit multiplier: $4950 profit for Prince (230 tonnage) over BENCHMARK_DIST
    const PROFIT_PER_UNIT_PER_TON = (4950 / 230) / BENCHMARK_DIST; 

    // Constant time factor calibrated from: Sainte Rose -> Port Louis (304.7 units) @ 21.5 kts = 25 min
    const BENCHMARK_TIME_FACTOR = (25 * 21.5) / 304.7;

    function updateCompass() {
      const angle = parseFloat(document.getElementById('windInput').value) || 0;
      document.getElementById('windDegReadout').innerText = `${Math.round(angle)}°`;
      document.getElementById('compassNeedle').style.transform = `rotate(${angle}deg)`;
    }

    function initData() {
      const categories = {};
      RAW_MAP_DATA.categories.forEach(c => categories[c.id] = c.name);

      RAW_MAP_DATA.markers.forEach(marker => {
        const catName = categories[marker.categoryId] || "";
        if (catName.includes("Port")) {
          PORTS.push({
            name: marker.popup.title.trim(),
            faction: catName.replace(" Port", ""),
            x: marker.position[0],
            y: marker.position[1]
          });
        }
      });

      PORTS.sort((a, b) => a.name.localeCompare(b.name));

      const dropdown = document.getElementById('originIsland');
      PORTS.forEach(port => {
        const opt = document.createElement('option');
        opt.value = port.name;
        opt.textContent = `${port.name} (${port.faction})`;
        dropdown.appendChild(opt);
      });

      dropdown.value = "Sainte Rose";
      updateCompass();
      calculateRoutes();
    }

    function calculateRoutes() {
      const originName = document.getElementById('originIsland').value;
      const baseSpeed = parseFloat(document.getElementById('shipSpeed').value) || 21.5;
      const selectedShip = document.getElementById('shipSelect').value;
      const tonnage = SHIP_CONFIGS[selectedShip].tonnage;
      const windAngle = parseFloat(document.getElementById('windInput').value) || 0;

      const origin = PORTS.find(p => p.name === originName);
      const resultsBody = document.getElementById('resultsBody');
      resultsBody.innerHTML = '';

      const routeData = [];

      PORTS.forEach(dest => {
        if (dest.name === originName) return;

        const dx = dest.x - origin.x;
        const dy = dest.y - origin.y;
        const directDistance = Math.hypot(dx, dy);

        let directBearing = Math.atan2(dx, dy) * (180 / Math.PI);
        if (directBearing < 0) directBearing += 360;

        // Check if route is within 90 degrees left or right of wind heading
        let diff = Math.abs(directBearing - windAngle) % 360;
        if (diff > 180) diff = 360 - diff;

        const isPossible = diff <= 90;

        if (isPossible) {
          const travelTimeMin = (directDistance / baseSpeed) * BENCHMARK_TIME_FACTOR;
          const profit = directDistance * PROFIT_PER_UNIT_PER_TON * tonnage;

          routeData.push({
            name: dest.name,
            bearing: Math.round(directBearing),
            isPossible: true,
            timeNum: travelTimeMin,
            timeStr: travelTimeMin.toFixed(1),
            profit: Math.round(profit)
          });
        } else {
          routeData.push({
            name: dest.name,
            bearing: Math.round(directBearing),
            isPossible: false,
            timeNum: Infinity,
            timeStr: "--",
            profit: 0
          });
        }
      });

      // Sort by Est. Time ascending (Shortest trips first, Impossible at bottom)
      routeData.sort((a, b) => {
        if (a.isPossible !== b.isPossible) return b.isPossible ? 1 : -1;
        return a.timeNum - b.timeNum;
      });

      routeData.forEach(route => {
        const row = document.createElement('tr');
        if (!route.isPossible) row.classList.add('impossible-row');
        
        const badge = route.isPossible 
          ? `<span class="badge badge-valid">Possible</span>` 
          : `<span class="badge badge-impossible">Impossible</span>`;

        row.innerHTML = `
          <td><strong>${route.name}</strong></td>
          <td style="color: var(--accent); font-weight: bold;">${route.bearing}°</td>
          <td>${badge}</td>
          <td>${route.timeStr !== "--" ? route.timeStr + ' min' : '--'}</td>
          <td style="color: ${route.isPossible ? '#4ade80' : 'var(--text-muted)'}; font-weight: bold;">
            ${route.isPossible ? '$' + route.profit.toLocaleString() : '--'}
          </td>
        `;
        resultsBody.appendChild(row);
      });
    }

    window.onload = initData;
  </script>
</body>
</html>
